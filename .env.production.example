# ============================================================================
# TEMPLATE ONLY — no values. Copy to `.env.production` ON THE SERVER and fill in.
#
# `.env.production` is gitignored because this repository is public and two of
# these keys are live credentials. It is created once, by hand, on the server.
# `git pull` never touches an ignored file, so it survives every deployment.
#
#   cp .env.production.example .env.production
#   nano .env.production
#
# If the application boots and cannot reach the database, this file is the first
# thing to check: a missing `.env.production` reads as a connection failure
# because `session-verify.js` falls back to `'root'` for the password.
# ============================================================================

# ── Database ──
DB_HOST=
DB_USER=
DB_PASSWORD=
DB_NAME=

# ── Application ──
# 64 hex characters. Changing it makes every value already encrypted with the
# old key unreadable, so it is set once and then left alone.
ENCRYPTION_KEY=

# 64 hex characters, and a DIFFERENT value from the one above. Encrypts the SMTP
# passwords in `email_profiles`.
#
# REQUIRED. `lib/email-profiles.ts` used to fall back to a key written into its
# own source, which `output: 'standalone'` compiled into `.next/server/` — a
# folder this public repository carries. The key was therefore published, and
# GitGuardian reported it.
#
# The fallback is gone and the module now throws without this variable. Any SMTP
# password stored before it was set was encrypted with the published key: it
# cannot be read with a new one, so re-enter each password under
# Settings > Integration > Email, and change it at the mail provider as well.
EMAIL_ENCRYPTION_KEY=

# Both are the public origin, including the scheme. No trailing slash.
NEXT_PUBLIC_BASE_URL=
SITE_URL=

NODE_ENV=production
